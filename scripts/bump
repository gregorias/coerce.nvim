#!/bin/bash
# Bumps the version.
#
# 1. Asks the user to choose a new version.
# 2. Updates TBR — <date> section in the changelog with the new version.
# 3. Creates a chore change with the changes.
# 4. Tags the change with `vVERSION`.
#
# Bumping only works on empty working copies to prevent overriding work.

set -euo pipefail

if test "$(jj log -r @ --no-graph -T 'if(empty, "empty", "non-empty")')" = "non-empty"; then
  echo "You are trying to bump on a non-empty working copy. Run jj new before bumping." >&2
  exit 1
fi

current_version=$(bump-my-version show current_version)
echo "Current version: $current_version"
echo "Choose the version bump:"
version_type=$(gum choose "patch" "minor" "major")

cleanup () {
  echo "Bump failed; rolling back changes…"
  jj restore
}
# If the bump fails and only does a partial update, roll-back the changes.
trap cleanup ERR

bump-my-version bump "$version_type";

new_version=$(bump-my-version show current_version)
# If we just tag the working copy, JJ will show a warning, because tagged
# changes become immutable.
jj commit -m "chore: bump $current_version → $new_version"
jj tag set "v$new_version" -r @-
jj tag track "v$new_version@origin"

echo "✅ Bumped to version $new_version successfully!"
